# Copy to .env and change every value marked CHANGE_ME.

# API
# Long random value, e.g. output of: openssl rand -hex 32
# It also encrypts stored secrets (2FA, connector credentials): do not change it after setup.
MENTIS_SECRET_KEY=CHANGE_ME
# Keep true behind HTTPS. Set to false only to test over plain http://localhost.
MENTIS_COOKIE_SECURE=true
# URL users open in the browser; used in invitation links.
MENTIS_PUBLIC_URL=https://mentis.example.com

# PostgreSQL
POSTGRES_DB=mentis
POSTGRES_USER=mentis
POSTGRES_PASSWORD=CHANGE_ME

# MinIO (object storage for original documents)
MINIO_ROOT_USER=mentis
MINIO_ROOT_PASSWORD=CHANGE_ME_min_8_chars

# Qdrant (vector database)
QDRANT_API_KEY=CHANGE_ME

# Redis (job queue)
REDIS_PASSWORD=CHANGE_ME

# Documents
MENTIS_MAX_UPLOAD_MB=50
# Parser: "standard" (default, tested) or "docling" (verify in the lab first; also set
# MENTIS_PARSER_EXTRAS=worker,docling so the worker image includes it — large download).
MENTIS_PARSER=standard
MENTIS_PARSER_EXTRAS=worker
# Worker resource limits
MENTIS_WORKER_CPUS=2
MENTIS_WORKER_MEMORY=3g
